# Copy to .env and fill in. Never commit .env.
# Get a key at https://dev.meta.ai/platform
MODEL_API_KEY=

# Optional: live voice tutor (Talk live). LiveKit Cloud free tier is enough;
# the agent in ../agent also reads these. Leave blank to disable live voice.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional overrides (these are the defaults)
# MODEL_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1
# SPARK_REASONING_EFFORT=low
# PORT=3000
