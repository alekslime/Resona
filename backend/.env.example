# Copy to .env and fill in. Never commit .env.
# Get a key at https://dev.meta.ai/platform
MODEL_API_KEY=

# Optional: live voice tutor (Talk live). LiveKit Cloud free tier is enough;
# the agent in ../agent also reads these. Leave blank to disable live voice.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional overrides (these are the defaults)
# MODEL_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# SPARK_REASONING_EFFORT=low
# Behind Fly.io/Railway the client IP arrives in X-Forwarded-For: set
# TRUST_PROXY=1 so each visitor gets their own rate-limit bucket. Leave
# unset when node itself faces the internet, so spoofed headers are ignored.
# TRUST_PROXY=1
# PORT=3000
